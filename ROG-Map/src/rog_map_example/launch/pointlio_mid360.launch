<launch>
  <arg name="rviz" default="false" />
  <node name="rm_node" pkg="rog_map_example" type="marsim_example_node" output="screen">
    <rosparam command="load" file="$(find rog_map_example)/config/pointlio_mid360.yaml"/>
  </node>
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_camera_init"
        args="0 0 0 0 0 0 world camera_init" />
  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rogmap_rviz"
          args="-d $(find rog_map_example)/config/viz_pointlio.rviz" />
  </group>
</launch>
